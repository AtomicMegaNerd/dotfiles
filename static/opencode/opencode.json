{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "rcd-go": {
      "color": "#00ADD8",
      "mode": "all",
      "permissions": [
        {
          "action": "read",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "edit",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "glob",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "grep",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "shell",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "task *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "golangci-lint *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "go *"
        },
        {
          "action": "webfetch",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "rcd-golang"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "rcd-golangci-lint"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "rcd-go-task"
        },
        {
          "action": "subagent",
          "effect": "allow",
          "resource": "go"
        }
      ]
    },
    "rcd-nix": {
      "color": "#5277C3",
      "mode": "all",
      "permissions": [
        {
          "action": "read",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "edit",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "glob",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "grep",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "shell",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "nh search *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "nix flake check *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "nix flake metadata *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "nix flake show *"
        },
        {
          "action": "webfetch",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nix-language"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nix-workflow"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "home-manager"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nix-darwin"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nixos-operations"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nixos-wiki"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nixpkgs-development"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/tmp/**"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh repo read-file *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh repo view *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh repo read-dir *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh search *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh pr list *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh pr view *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh issue list *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh issue view *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "yamllint *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "markdownlint-cli2 *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "date *"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.envrc"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env.*"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "*/tmp/*"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "/tmp/**"
    },
    {
      "action": "glob",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "grep",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "webfetch",
      "effect": "allow",
      "resource": "*"
    }
  ]
}
