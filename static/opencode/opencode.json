{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "rcd-go": {
      "color": "#00ADD8",
      "description": "Go programming, build, lint, and test expert",
      "mode": "all",
      "permissions": [
        {
          "action": "read",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "edit",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "glob",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "grep",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "shell",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "task *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "golangci-lint *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "go *"
        },
        {
          "action": "webfetch",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "go"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "task"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "golangci-lint"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "go-task"
        },
        {
          "action": "subagent",
          "effect": "allow",
          "resource": "go"
        }
      ],
      "system": "# RCD Go Agent\n\nYou are a Go programming expert. You have access to the skills listed below that\nyou should load when relevant:\n\n- `rcd-golang` — Idiomatic Go patterns and best practices). Load this when\n  writing, reviewing, or refactoring Go code.\n- `rcd-go-task` — The Task build tool. Load this when running builds, tests, or lints.\n- `rcd-golangci-lint` — The linter. Load this when running or configuring the linter.\n\n**Always load the `go` skill immediately.** Load `task`, `go-task`, and\n`golangci-lint` as needed.\n\nFor Azure functions pipeline work, deployment, troubleshooting, etc. please\ndelegate to the **azfunc-go** agent.\n\n## pkg.go.dev CLI Tool\n\n**`pkgsite-cli`** is the best way to lookup reference information for Go code that\nis published to `pkgs.go.dev`. This tool will be installed in Go projects already.\n\n```bash\npkgsite-cli search \"uuid\"\npkgsite-cli package github.com/google/go-cmp/cmp\npkgsite-cli package --imported-by github.com/google/go-cmp/cmp\npkgsite-cli package --symbols github.com/google/go-cmp/cmp\npkgsite-cli module -versions github.com/google/go-cmp\npkgsite-cli module -packages github.com/google/go-cmp\n```\n"
    },
    "rcd-nix": {
      "color": "#5277C3",
      "description": "Nix, Home Manager, nix-darwin, and NixOS configuration expert",
      "mode": "all",
      "permissions": [
        {
          "action": "read",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "edit",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "glob",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "grep",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "shell",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "nh search *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "nix flake check *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "nix flake info *"
        },
        {
          "action": "shell",
          "effect": "allow",
          "resource": "nix flake show *"
        },
        {
          "action": "webfetch",
          "effect": "allow",
          "resource": "*"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nix-language"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nix-workflow"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "home-manager"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nix-darwin"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nixos-operations"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nixos-wiki"
        },
        {
          "action": "skill",
          "effect": "allow",
          "resource": "nixpkgs-development"
        }
      ],
      "system": "# RCD Nix Agent\n\nYou are a Nix configuration expert for this flake. You have access to the skills listed\nbelow that you should load when relevant:\n\n- `nix-language` — Nix expression language. Load this when writing, reviewing, or\n  refactoring Nix syntax.\n- `nix-workflow` — Nix commands, the store, flakes, and ecosystem tooling. Load this for\n  builds, evaluations, and store management.\n- `home-manager` — Home Manager user environments. Load this for user configuration in\n  `nix/` and `hosts/*/rcd.nix`.\n- `nix-darwin` — macOS system configuration. Load this for `hosts/Schooner/darwin.nix`.\n- `nixos-operations` — NixOS system operations. Load this for\n  `hosts/blahaj/configuration.nix` and NixOS rebuilds.\n- `nixos-wiki` — Retained NixOS Wiki guidance. Load this for system-level NixOS options\n  and troubleshooting.\n- `nixpkgs-development` — Nixpkgs packaging and APIs. Load this for package overrides,\n  overlays, or working with `nixpkgs.lib`/`pkgs`.\n\nThis flake uses `nixpkgs` (stable) for NixOS and `nixpkgs-unstable` for Home Manager,\nnix-darwin, and development tooling. Prefer `nh` for switching configurations when\nappropriate:\n"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "disabled": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/tmp/**"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh repo read-file *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh repo view *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh repo read-dir *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh search *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh pr list *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh pr view *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh issue list *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh issue view *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "yamllint *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "markdownlint-cli2 *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "date *"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.envrc"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env.*"
    },
    {
      "action": "edit",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "*/tmp/*"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "/tmp/**"
    },
    {
      "action": "glob",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "grep",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "webfetch",
      "effect": "allow",
      "resource": "*"
    }
  ]
}
