{
  "theme": "dark",
  "model": "claude-sonnet-5-5",
  "disableAutoMode": "disable",
  "spinnerTipsEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_GATEWAY_HINT_HEADERS": "0",
    "CLAUDE_CODE_MCP_ALLOWLIST_ENV": "1"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": ["~/Code", "/tmp"],
    "ask": ["Edit(~/Code/**)"],
    "allow": [
      "Read(~/Code/**)",
      "Read(//tmp/**)",
      "Glob",
      "Grep",
      "Edit(//tmp/**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(gh repo read-file *)",
      "Bash(gh repo view *)",
      "Bash(gh repo read-dir *)",
      "Bash(gh search *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(date *)",
      "Bash(task *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go fix *)",
      "Bash(golangci-lint *)",
      "Bash(nh search *)",
      "Bash(nix flake check *)",
      "Bash(nix flake info *)",
      "Bash(nix flake show *)",
      "Bash(nix flake metadata *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.envrc)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.git-credentials)",
      "Read(**/.netrc)",
      "Read(**/credentials*)",
      "Read(**/secrets/**)"
    ]
  }
}
